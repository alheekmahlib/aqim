<?xml version="1.0" encoding="utf-8"?>
<!-- إشعار العدّ التنازلي الدائم: عمودان يحاكيان بطاقة Live Activity في iOS.
     العدّادان Chronometer أصليان — النظام يحدّثهما كل ثانية بلا أي عمل
     من التطبيق؛ الأول بسمة countDown للعدّ حتى الصلاة القادمة والثاني
     يعدّ تصاعديًا منذ الصلاة السابقة. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_countdown_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layoutDirection="locale"
    android:baselineAligned="false"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/prayer_countdown_next_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@android:style/TextAppearance.Material.Notification"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/prayer_countdown_next_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <Chronometer
            android:id="@+id/prayer_countdown_next_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@android:style/TextAppearance.Material.Notification.Time"
            android:textSize="23sp"
            android:textStyle="bold"
            android:countDown="true" />
    </LinearLayout>

        <!-- فاصل عمودي: TextView بعرض 1dp لأن RemoteViews لا يسمح بتضخيم
             android.view.View المجرد (قائمة بيضاء للفئات المسموحة). -->
        <TextView
            android:id="@+id/prayer_countdown_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@android:color/darker_gray"
            android:alpha="0.35" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/prayer_countdown_elapsed_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@android:style/TextAppearance.Material.Notification"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/prayer_countdown_prev_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <Chronometer
            android:id="@+id/prayer_countdown_elapsed_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@android:style/TextAppearance.Material.Notification.Time"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
